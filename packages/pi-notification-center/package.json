{
  "name": "@sherif-fanous/pi-notification-center",
  "version": "0.2.0",
  "description": "Pi extension: notification center that replaces transcript notices with passive toasts and a browsable session history.",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "notifications",
    "notification-center",
    "toast",
    "tui"
  ],
  "homepage": "https://github.com/sherif-fanous/pi-notification-center#readme",
  "bugs": {
    "url": "https://github.com/sherif-fanous/pi-notification-center/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherif-fanous/pi-notification-center.git"
  },
  "license": "MIT",
  "author": "Sherif Fanous",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "format": "prettier --write eslint.config.mjs examples/. package.json src/. tests/. tsconfig.json vitest.config.ts",
    "format-check": "prettier --check eslint.config.mjs examples/. package.json src/. tests/. tsconfig.json vitest.config.ts",
    "lint": "biome lint examples/. src/. tests/. && eslint examples/. src/. tests/.",
    "sort-package-json": "npx sort-package-json",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "prettier": {
    "importOrder": [
      "<BUILTIN_MODULES>",
      "",
      "<THIRD_PARTY_MODULES>"
    ],
    "importOrderTypeScriptVersion": "6.0.0",
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.9.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "prettier": "^3.9.6",
    "sort-package-json": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
