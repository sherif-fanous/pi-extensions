{
  "name": "@sherif-fanous/pi-extensions-core",
  "version": "0.1.0",
  "description": "Shared runtime helpers for Pi extensions.",
  "keywords": [
    "pi",
    "pi-coding-agent"
  ],
  "homepage": "https://github.com/sherif-fanous/pi-extensions/tree/main/packages/pi-extensions-core#readme",
  "bugs": {
    "url": "https://github.com/sherif-fanous/pi-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherif-fanous/pi-extensions.git",
    "directory": "packages/pi-extensions-core"
  },
  "license": "MIT",
  "author": "Sherif Fanous",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "prettier": {
    "importOrder": [
      "<BUILTIN_MODULES>",
      "",
      "<THIRD_PARTY_MODULES>"
    ],
    "importOrderTypeScriptVersion": "6.0.0",
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "overrides": [
      {
        "files": [
          "*.md",
          "*.mdx"
        ],
        "options": {
          "printWidth": 80,
          "proseWrap": "always"
        }
      }
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.9.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "prettier": "^3.9.6",
    "sort-package-json": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
